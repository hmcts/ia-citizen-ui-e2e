#!groovy

properties([
  pipelineTriggers([cron('H 10 * * 1-5')]),
  disableConcurrentBuilds(),
  parameters([
    choice(
      name: 'ENVIRONMENT',
      choices: ['aat', 'preview'],
      description: 'Environment to run the test.'
    ),
    booleanParam(
      name: 'CHROME',
      defaultValue: true,
      description: 'Run E2E tests in Chrome (on by default).'
    ),
     booleanParam(
      name: 'FIREFOX_TESTS',
      defaultValue: false,
      description: 'Run E2E tests in Firefox.'
    ),
     booleanParam(
      name: 'WEBKIT_TESTS',
      defaultValue: false,
      description: 'Run E2E tests in Safari (WebKit).'
    ),
     booleanParam(
      name: 'EDGE_TESTS',
      defaultValue: false,
      description: 'Run E2E tests in Edge.'
    )]) 
])

@Library("Infrastructure")

def type = "nodejs"
def product = "ia"
def component = "Citizen-Frontend"

def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)

static Map secret(String secretName, String envVariable) {
  [$class     : 'AzureKeyVaultSecret',
   secretType : 'Secret',
   name       : secretName,
   envVariable: envVariable
  ]
}
def secrets = [
        "ia-${params.ENVIRONMENT}": [
                secret('github-branch-secret', 'GITHUB_TOKEN'),
                secret('idam-client-id', 'IDAM_CLIENT_ID'),
                secret('idam-secret', 'IDAM_SECRET'),
                secret('test-caseofficer-username', 'CASE_OFFICER_USERNAME'),
                secret('test-caseofficer-password', 'CASE_OFFICER_PASSWORD'),
                secret('test-law-firm-noc-a-bails-username', 'LEGAL_REP_USERNAME'),
                secret('test-law-firm-noc-a-bails-password', 'LEGAL_REP_PASSWORD'),
                secret('test-adminofficer-username', 'ADMIN_OFFICER_USERNAME'),
                secret('test-adminofficer-password', 'ADMIN_OFFICER_PASSWORD'),
                secret('test-homeoffice-generic-username', 'HOME_OFFICE_USERNAME'),
                secret('test-homeoffice-generic-password', 'HOME_OFFICE_PASSWORD'),
                secret('test-judge-x-username', 'JUDGE_USERNAME'),
                secret('test-judge-x-password', 'JUDGE_PASSWORD'),
                secret('idam-citizen-user-password', 'IDAM_CITIZEN_USER_PASSWORD')
        ]
]


withNightlyPipeline(type, product, component) {
  loadVaultSecrets(secrets)
  environmentSetup(yarnBuilder)

  afterAlways('DependencyCheckNightly') {
    stage('Set up playwright') {
      try { yarnBuilder.yarn('setup') }
      catch (Error) { unstable("${STAGE_NAME} is unstable: ${Error}") }
    }
    runFunctionalTest(yarnBuilder)
  }
}

def environmentSetup(yarnBuilder) {
  env.TEST_ENVIRONMENT = params.ENVIRONMENT
  env.IDAM_WEB_URL = "https://idam-web-public.${env.TEST_ENVIRONMENT}.platform.hmcts.net/"
  env.IDAM_TESTING_SUPPORT_URL = "https://idam-testing-support-api.${env.TEST_ENVIRONMENT}.platform.hmcts.net"
  env.CITIZEN_FRONTEND_BASE_URL = "https://immigration-appeal.${env.TEST_ENVIRONMENT}.platform.hmcts.net/"
  env.S2S_URL = "http://rpe-service-auth-provider-${env.TEST_ENVIRONMENT}.service.core-compute-aat.internal/lease"
}

def runFunctionalTest(yarnBuilder) {
  def e2eMatrix = [
    [flag: 'CHROME', project: 'chrome', browser: 'Chrome', label: 'Desktop Chrome'],
    [flag: 'FIREFOX_TESTS', project: 'firefox', browser: 'Firefox', label: 'Desktop Firefox'],
    [flag: 'WEBKIT_TESTS', project: 'webkit', browser: 'Safari', label: 'Desktop Safari (WebKit)'],
    [flag: 'EDGE_TESTS', project: 'edge', browser: 'Edge', label: 'Desktop Edge'],
  ]
  e2eMatrix.each { row ->
    if (params[row.flag]) {
      runFunctionalStage(yarnBuilder, row.project, row.browser, row.label)
    }
  }
}

def runFunctionalStage(yarnBuilder, String playwrightProject, String browser, String stageLabel) {
  stage("E2E - ${stageLabel}") {
      catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
        withEnv(["PLAYWRIGHT_PROJECT=${playwrightProject}"]) {
          yarnBuilder.yarn('test:e2e')
        }
      }
      publishHTML([
          allowMissing: false,
          alwaysLinkToLastBuild: true,
          keepAll: true,
          reportDir: 'playwright-report',
          reportFiles: 'index.html',
          reportName: 'Test Report'
        ])
    }
}
